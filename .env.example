# ============================================================================
# GEMINI API CONFIGURATION
# ============================================================================
# GEMINI_API_KEY: Required for AI-powered OCR vision processing.
# Get your key from: https://ai.google.dev/
# If not set, the app will fall back to heuristic text-based parsing.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# PORT: Server port (default: 3000)
# For production deployments, set via hosting platform environment variables.
PORT=3000

# NODE_ENV: Application environment (development | production)
# Set to "production" for production deployments.
# Affects logging verbosity, static file serving, and error handling.
NODE_ENV="development"

# ============================================================================
# APPLICATION URL (Optional)
# ============================================================================
# APP_URL: The public URL where this app is deployed.
# Used for self-referential links, OAuth callbacks, and API documentation.
# Example: https://my-app.example.com or https://my-app.cloud.google.com
APP_URL="http://localhost:3000"
